# Moltagent Environment Configuration
#
# DEPLOYMENT NOTE: The reference deployment (Prime VM) configures these variables
# via systemd unit environment and credential files, not via a .env file.
# This file documents all variables the codebase reads and serves as a template
# for local development and alternative deployments.
#
# Copy this file to .env and customize values for your deployment
# All values shown are defaults (except secrets which must be set)

# =============================================================================
# REQUIRED - Must be set for the application to work
# =============================================================================

# Nextcloud Talk webhook secret (for signature verification)
NC_TALK_SECRET=your-webhook-secret-here

# Nextcloud credentials - use ONE of the following methods:
# Option 1: Direct password (not recommended for production)
# NC_PASSWORD=your-app-password
# Option 2: Credential file path
# NC_CREDENTIAL_FILE=/path/to/credential/file
# Option 3: systemd credential (recommended for production)
# CREDENTIALS_DIRECTORY=/run/credentials/moltagent.service

# =============================================================================
# NEXTCLOUD CONNECTION
# =============================================================================

# Nextcloud base URL
NC_URL=https://your-nextcloud-instance.com

# Nextcloud username for API calls
NC_USER=moltagent

# Primary Talk room for proactive messages (daily digest, meeting prep, alerts).
# This is the default room when no specific room is targeted.
# Create this room in NC Talk and add the bot user, then paste its token here.
TALK_PRIMARY_ROOM=your-primary-room-token

# Legacy aliases (still work, TALK_PRIMARY_ROOM takes precedence):
# TALK_ROOM_TOKEN=your-room-token
# NC_TALK_DEFAULT_TOKEN=your-room-token

# Allowed webhook backend URLs (comma-separated, defaults to NC_URL)
# NC_TALK_BACKENDS=https://nc1.example.com,https://nc2.example.com

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Ollama API endpoint
OLLAMA_URL=http://localhost:11434

# Default Ollama model
OLLAMA_MODEL=qwen3:8b

# Credential-dedicated Ollama model (heavier, for sensitive ops; falls back to OLLAMA_MODEL)
OLLAMA_MODEL_CREDENTIAL=qwen3:14b-fast

# Embedding model for semantic memory (#96). Must be pulled on the Ollama host;
# the boot preflight probes it as an optional dependency.
EMBEDDING_MODEL=nomic-embed-text

# Proactive initiative level (0-3). Higher = more proactive behavior (default 1)
INITIATIVE_LEVEL=1

# Daily cloud spend budget (USD) for proactive operations (default 0.50)
# PROACTIVE_DAILY_BUDGET=0.50

# Boot preflight (#87): a REQUIRED dependency that is definitively absent
# (Talk/Deck/Collectives app not installed) halts boot with a remediation line.
# Set to "warn" to demote that halt to a warning (escape hatch; leave unset).
# MOLTAGENT_PREFLIGHT=warn

# Claude premium model (deep reasoning, complex writing — expensive)
CLAUDE_MODEL_PREMIUM=claude-opus-4-6

# Claude standard model (tool calls, quick tasks, research — 5x cheaper)
CLAUDE_MODEL_STANDARD=claude-sonnet-4-5-20250929

# Ollama request timeout in ms (covers cold start + inference; default 5 min)
OLLAMA_TIMEOUT=300000

# Fast local model for classification/quick tasks (falls back to OLLAMA_CLASSIFY_MODEL)
# OLLAMA_MODEL_FAST=qwen2.5:3b

# Local classification model (the seated classifier under local-only trust)
# OLLAMA_CLASSIFY_MODEL=qwen2.5:3b

# Per-call Ollama timeouts (ms): generic tool calls, domain tool calls, classification
# OLLAMA_TOOL_TIMEOUT=60000
# OLLAMA_DOMAIN_TOOL_TIMEOUT=90000
# OLLAMA_CLASSIFY_TIMEOUT=30000

# Synthesis provider for knowledge answers: 'local' (default) or 'cloud'
# SYNTHESIS_PROVIDER=local

# DeepSeek — optional budget cloud tier (~$0.14/1M input tokens)
# To enable: set the API key and uncomment, then add deepseek to providers.yaml
# DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# HTTP server port
PORT=3000

# Bind host (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Public base URL of this agent (used to build the OAuth callback redirect).
# Falls back to NC_URL when unset.
# AGENT_PUBLIC_URL=https://your-agent-host.example.com

# =============================================================================
# SECURITY
# =============================================================================

# Enable strict mode for signature verification
STRICT_MODE=true

# Enable debug logging (disable in production)
DEBUG_MODE=false

# =============================================================================
# TIMEOUTS (milliseconds)
# =============================================================================

# General HTTP request timeout
TIMEOUT_HTTP_REQUEST=30000

# Ollama health check timeout
TIMEOUT_OLLAMA_HEALTH=5000

# Deck API request timeout
TIMEOUT_DECK_API=30000

# IMAP connection timeout
TIMEOUT_IMAP=30000

# SMTP connection timeout
TIMEOUT_SMTP=30000

# Graceful shutdown timeout
TIMEOUT_SHUTDOWN=30000

# =============================================================================
# NEXTCLOUD REQUEST MANAGER (Rate Limiting)
# =============================================================================

# Max concurrent requests to Nextcloud
NC_MAX_CONCURRENT=4

# Default retry delay on 429 (ms)
NC_RETRY_AFTER=30000

# Max request queue size
NC_MAX_QUEUE=1000

# Max retries for failed requests
NC_MAX_RETRIES=3

# =============================================================================
# CACHE TTLs (milliseconds)
# =============================================================================

# NC Passwords API cache
CACHE_TTL_PASSWORDS=300000

# CalDAV cache
CACHE_TTL_CALDAV=60000

# Deck API cache
CACHE_TTL_DECK=30000

# WebDAV cache
CACHE_TTL_WEBDAV=30000

# Talk API cache
CACHE_TTL_TALK=5000

# OCS API cache
CACHE_TTL_OCS=30000

# Credential cache
CACHE_TTL_CREDENTIALS=30000

# Collectives (wiki) cache
CACHE_TTL_COLLECTIVES=60000

# CardDAV (contacts) cache
CACHE_TTL_CARDDAV=60000

# =============================================================================
# HEARTBEAT MANAGER
# =============================================================================

# Heartbeat interval (ms) - how often to check for tasks
HEARTBEAT_INTERVAL=300000

# Quiet hours (24h format) - no notifications during these hours
QUIET_START=22
QUIET_END=7

# Max tasks to process per heartbeat cycle
HEARTBEAT_MAX_TASKS=3

# Calendar lookahead for upcoming events (minutes)
HEARTBEAT_CALENDAR_LOOKAHEAD=30

# Enable Deck task processing
HEARTBEAT_DECK_ENABLED=true

# Enable CalDAV calendar processing
HEARTBEAT_CALDAV_ENABLED=true

# =============================================================================
# EMAIL MONITOR
# =============================================================================

# Initial delay before first email check (ms)
EMAIL_MONITOR_INITIAL_DELAY=30000

# Email check interval (ms)
EMAIL_CHECK_INTERVAL=60000

# Max pending email notifications in queue
EMAIL_MAX_PENDING=10

# Time before notification is considered stale (ms)
EMAIL_STALE_NOTIFICATION=86400000

# Max processed email IDs to track (prevents reprocessing)
EMAIL_MAX_PROCESSED_IDS=1000

# =============================================================================
# DECK INTEGRATION
# =============================================================================

# Default Deck board ID
DECK_BOARD_ID=8

# Days before completed tasks are archived
DECK_ARCHIVE_AFTER_DAYS=180

# Board titles the bot resolves by name (created if absent)
# DECK_TASK_BOARD=Moltagent Tasks
# DECK_COCKPIT_BOARD=Moltagent Cockpit
# DECK_PERSONAL_BOARD=Personal

# =============================================================================
# COCKPIT / OWNER IDENTITY
# =============================================================================

# Nextcloud username of the instance owner. Used for:
# - Cockpit Deck control plane (admin operations)
# - Calendar alert scoping (only alert for events the owner is attending)
# If unset, calendar alerts fire for ALL visible events (shared calendars included).
ADMIN_USER=

# Cockpit control-plane board (Deck-as-config)
# COCKPIT_ENABLED=true
# COCKPIT_BOARD_TITLE=Moltagent Cockpit
# COCKPIT_CACHE_TTL=300000

# =============================================================================
# KNOWLEDGE (Collectives Wiki)
# =============================================================================

# Admin user to share the knowledge collective with (empty = no sharing)
# KNOWLEDGE_ADMIN_USER=your-admin-username

# Collective (wiki) name the stewards maintain
# KNOWLEDGE_COLLECTIVE=Moltagent Knowledge

# Default decay window (days) before a fact is flagged stale
# KNOWLEDGE_DECAY_DAYS=90

# Default confidence for newly written facts: low | medium | high
# KNOWLEDGE_DEFAULT_CONFIDENCE=medium

# Freshness steward: periodic scan for stale pages
# KNOWLEDGE_FRESHNESS_ENABLED=true
# KNOWLEDGE_FRESHNESS_INTERVAL=3600000
# KNOWLEDGE_FRESHNESS_MAX_PAGES=20

# =============================================================================
# LLM RESILIENCE
# =============================================================================

# Max tokens for LLM responses
LLM_MAX_TOKENS=1024

# Circuit breaker: failures before opening
LLM_CB_THRESHOLD=5

# Circuit breaker: time before retry (ms)
LLM_CB_RESET=60000

# Circuit breaker: successes needed to close
LLM_CB_SUCCESS=3

# Loop detector: time window (ms)
LLM_LOOP_WINDOW=60000

# Loop detector: max same calls before detected
LLM_LOOP_MAX_SAME=5

# Loop detector: max errors before detected
LLM_LOOP_MAX_ERRORS=3

# Loop detector: ping-pong threshold
LLM_LOOP_PINGPONG=4

# Backoff: initial delay (ms)
LLM_BACKOFF_INITIAL=1000

# Backoff: max delay (ms)
LLM_BACKOFF_MAX=300000

# Backoff: multiplier per attempt
LLM_BACKOFF_MULTIPLIER=2

# Backoff: max attempts before giving up
LLM_BACKOFF_MAX_ATTEMPTS=5

# =============================================================================
# PENDING ACTIONS (Human-in-the-Loop)
# =============================================================================

# Confirmation request expiry (ms)
PENDING_CONFIRMATION_TTL=300000

# Email reply expiry (ms)
PENDING_EMAIL_REPLY_TTL=1800000

# Cleanup interval for expired actions (ms)
PENDING_CLEANUP_INTERVAL=300000

# =============================================================================
# WEB SEARCH (SearXNG)
# =============================================================================

# SearXNG instance URL (required for web search tool)
SEARXNG_URL=http://localhost:8080

# Max results per search query
# SEARXNG_DEFAULT_LIMIT=5

# SearXNG request timeout (ms)
# SEARXNG_TIMEOUT=10000

# Default search engines (comma-separated, empty = all)
# SEARXNG_DEFAULT_ENGINES=

# Default search language
# SEARXNG_DEFAULT_LANGUAGE=en

# =============================================================================
# MEMORY SEARCH
# =============================================================================

# Enable memory search tool (keyword search over wiki pages)
MEMORY_SEARCH_ENABLED=true

# Search backend: 'keyword' (default) or 'semantic' (future)
# MEMORY_SEARCH_BACKEND=keyword

# =============================================================================
# ROOM MONITOR (instant welcome messages for new rooms)
# =============================================================================

# Enable room monitoring (detects new rooms, sends welcome/activation messages)
ROOM_MONITOR_ENABLED=true

# Room check interval (ms) — how often to poll for new rooms
ROOM_MONITOR_INTERVAL=60000

# =============================================================================
# NC STATUS INDICATOR
# =============================================================================

# Set Molti's NC user status based on real-time activity (Ready, Thinking, etc.)
STATUS_INDICATOR_ENABLED=true

# =============================================================================
# VOICE PIPELINE (Speaches STT/TTS)
# =============================================================================

# Speaches/Whisper STT endpoint (both clients point here)
WHISPER_URL=http://YOUR_OLLAMA_IP:8014
SPEACHES_URL=http://YOUR_OLLAMA_IP:8014

# Whisper request timeout (ms)
# WHISPER_TIMEOUT=60000

# Whisper model name
# WHISPER_MODEL=small

# Enable voice pipeline
# VOICE_ENABLED=true

# Speaches request timeout (ms)
# SPEACHES_TIMEOUT=30000

# Speaches STT model
# SPEACHES_STT_MODEL=Systran/faster-whisper-small

# Speaches TTS model and voice
# SPEACHES_TTS_MODEL=piper
# SPEACHES_TTS_VOICE=en_US-amy-medium

# Path to the ffmpeg binary used for audio transcoding
# FFMPEG_PATH=ffmpeg

# Max accepted audio duration (seconds) for a voice message
# VOICE_MAX_DURATION=300

# =============================================================================
# TEXT EXTRACTION & OCR (scanned PDF processing)
# =============================================================================

# Enable OCR fallback for scanned PDFs (requires ocrmypdf + tesseract on Bot VM)
OCR_ENABLED=true

# Tesseract language string ('+'-separated)
# Install matching language packs: sudo apt install tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-por
OCR_LANGUAGES=eng+deu+por

# CPU cores for ocrmypdf (limit to prevent event loop starvation)
# OCR_JOBS=1

# Max OCR processing time in ms (2 minutes default; increase for large documents)
# OCR_TIMEOUT=120000

# Characters per page below which a PDF is considered scanned
# Normal PDF pages have 2000-3000 chars; scanned pages have 0-20
# OCR_CHARS_THRESHOLD=50

# =============================================================================
# TALK NOTIFICATIONS & CONVERSATION CONTEXT
# =============================================================================

# Display name the bot uses in Talk
# TALK_BOT_NAME=Moltagent

# Include recent room history as context on each turn
# TALK_CONTEXT_ENABLED=true

# History window: max messages, max token estimate, and max age (ms)
# TALK_CONTEXT_MAX_MESSAGES=20
# TALK_CONTEXT_MAX_TOKENS=4000
# TALK_CONTEXT_MAX_AGE=7200000

# Include system messages (joins/leaves/etc.) in the context window
# TALK_CONTEXT_INCLUDE_SYSTEM=false

# =============================================================================
# CONTACTS (CardDAV)
# =============================================================================

# Address book name to read/write contacts in
# CONTACTS_ADDRESS_BOOK=contacts

# Contacts cache TTL (ms)
# CONTACTS_CACHE_TTL=3600000

# =============================================================================
# TIMEZONE
# =============================================================================

# IANA timezone identifier used for date formatting and scheduling
# TIMEZONE=UTC

# =============================================================================
# WEB READER (URL fetch + extract)
# =============================================================================

# Fetch timeout (ms), max download size (bytes), and max extracted text (chars)
# WEB_READER_TIMEOUT=15000
# WEB_READER_MAX_BYTES=5242880
# WEB_READER_MAX_CHARS=12000

# In-memory cache: TTL (ms) and max entries
# WEB_READER_CACHE_TTL=3600000
# WEB_READER_MAX_CACHE=50

# User-Agent header sent when fetching pages
# WEB_READER_USER_AGENT=Moltagent/1.0

# =============================================================================
# DOCUMENT INGESTION
# =============================================================================

# Enable Files ingestion pipeline
# INGEST_ENABLED=true

# Watched directories (comma-separated, relative to the user's Files root)
# INGEST_WATCH_DIRS=Projects

# Scan watched directories once at startup
# INGEST_STARTUP_SCAN=true

# =============================================================================
# NC FLOW (workspace event awareness)
# =============================================================================

# Inbound webhook receiver (Nextcloud Flow / webhook_listeners → this agent)
# NCFLOW_WEBHOOKS_ENABLED=false
# NCFLOW_WEBHOOKS_HOST=0.0.0.0
# NCFLOW_WEBHOOKS_PORT=3100
# NCFLOW_WEBHOOKS_SECRET=
# NCFLOW_WEBHOOKS_TRUSTED_IPS=
# NCFLOW_WEBHOOKS_SHUTDOWN_TIMEOUT=5000

# Activity-poll fallback (used when webhooks are not configured)
# NCFLOW_ACTIVITY_ENABLED=true
# NCFLOW_ACTIVITY_INTERVAL=60000
# NCFLOW_ACTIVITY_MAX_EVENTS=50
# NCFLOW_ACTIVITY_IGNORE_OWN=true
# NCFLOW_ACTIVITY_IGNORE_USERS=
# NCFLOW_ACTIVITY_ENABLED_TYPES=

# Systemtags applied to processed items (numeric NC tag IDs)
# NCFLOW_TAGS_ENABLED=true
# NCFLOW_TAG_PENDING_ID=2
# NCFLOW_TAG_PROCESSED_ID=5
# NCFLOW_TAG_NEEDS_REVIEW_ID=8
# NCFLOW_TAG_AI_FLAGGED_ID=11

# =============================================================================
# INFRASTRUCTURE MONITOR (self-heal via heald)
# =============================================================================

# Probe infrastructure health on the heartbeat and optionally self-heal
# INFRA_MONITOR_ENABLED=true
# INFRA_CHECK_INTERVAL=3
# INFRA_PROBE_TIMEOUT=8000
# INFRA_SELF_HEAL=true
# INFRA_NOTIFY_ON_FAILURE=true

# heald agent (remote self-heal executor). Unset URL = heald not deployed.
# HEALD_URL=http://your-heald-host:7867
# HEALD_TOKEN_CREDENTIAL=heald-token
# HEALD_TIMEOUT=15000

# =============================================================================
# TESTING (do not use in production)
# =============================================================================

# TEST_NC_PASSWORDS=true
